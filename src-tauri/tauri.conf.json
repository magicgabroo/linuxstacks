{
  "productName": "LinuxStacks",
  "version": "1.0.0",
  "identifier": "org.linuxstacks.LinuxStacks",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": {
      "title": "LinuxStacks",
      "width": 1200,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "fullscreen": false,
      "decorations": true,
      "transparent": false,
      "visible": true,
      "hiddenTitle": false,
      "security": {
        "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:;"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": [],
    "externalBin": ["external/qemu-system-x86_64"],
    "copyright": "© 2024 LinuxStacks Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Android emulator for Linux using KVM/QEMU",
    "longDescription": "LinuxStacks is a native Android emulator for Linux, built with Tauri, Rust, and Vue 3. Zero telemetry, zero ads.",
    "deb": {
      "depends": [
        "qemu-system-x86 (>= 6.0)",
        "qemu-kvm",
        "libwebkit2gtk-4.1-0 (>= 2.34)",
        "libgtk-3-0 (>= 3.24)",
        "librsvg2-2",
        "patchelf",
        "libayatana-appindicator3-1"
      ],
      "section": "utils",
      "priority": "optional",
      "licenseFile": "../LICENSE",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/256x256.png",
        "icons/512x512.png"
      ]
    },
    "appimage": {
      "bundleMediaFramework": false
    }
  }
}
