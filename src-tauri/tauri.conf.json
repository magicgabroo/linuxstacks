{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxStacks",
  "version": "1.0.0",
  "identifier": "org.linuxstacks.LinuxStacks",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinuxStacks",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "hiddenTitle": false,
        "theme": "default"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2024 LinuxStacks Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Android emulator for Linux",
    "longDescription": "LinuxStacks - Native Android emulator for Linux using KVM/QEMU",
    "deb": {
      "depends": [
        "qemu-system-x86",
        "qemu-kvm",
        "libvirt-daemon-system",
        "virt-manager",
        "libwebkit2gtk-4.1-0",
        "libgtk-3-0",
        "libayatana-appindicator3-1",
        "librsvg2-2"
      ],
      "section": "utils",
      "priority": "optional"
    },
    "rpm": {
      "depends": [
        "qemu-system-x86",
        "qemu-kvm",
        "libvirt-daemon",
        "virt-manager",
        "webkit2gtk4.1",
        "gtk3",
        "libayatana-appindicator-gtk3",
        "librsvg2"
      ],
      "license": "MIT"
    },
    "appimage": {
      "bundleMediaFramework": false
    },
    "flatpak": {
      "finishArgs": [
        "--device=kvm",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=xdg-run/virt-manager:ro",
        "--talk-name=org.libvirt",
        "--talk-name=org.freedesktop.Notifications",
        "--share=network",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--socket=x11"
      ],
      "modules": [
        {
          "name": "linuxstacks",
          "buildsystem": "simple",
          "buildCommands": [
            "install -Dm755 linuxstacks /app/bin/linuxstacks",
            "install -Dm644 linuxstacks.desktop /app/share/applications/linuxstacks.desktop",
            "install -Dm644 icons/256x256.png /app/share/icons/hicolor/256x256/apps/linuxstacks.png"
          ],
          "sources": [
            { "type": "file", "path": "linuxstacks" },
            { "type": "file", "path": "linuxstacks.desktop" },
            { "type": "file", "path": "icons/256x256.png" }
          ]
        }
      ]
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allowedPaths": [
          "$HOME/LinuxStacks/*",
          "$HOME/.config/linuxstacks/*",
          "/tmp/linuxstacks-*"
        ]
      }
    },
    "shell": {
      "scope": {
        "allowedPaths": [
          "qemu-system-x86_64",
          "qemu-img",
          "virsh",
          "virt-manager",
          "adb",
          "fastboot"
        ]
      }
    }
  }
}